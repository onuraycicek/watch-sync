# Copy to .env (`make .env`) and fill in. Everything is optional: what is left
# empty here is asked for in the extension's popup instead.

# Address of your deployed relay, e.g. wss://watch-sync.<your-subdomain>.workers.dev
# Set: users never see a server field. Empty: the popup asks for it once.
SERVER_URL=

# Default room for this build. Empty: every install starts in its own random
# room and friends join it by entering its code in the popup. Set: everyone with
# this build starts in the same room (keep the zip private then). 8-64 of A-Z 0-9.
ROOM_KEY=

# How many people can be in the room at the same time.
MAX_PEERS=2

# Optional: serve the relay on your own domain instead of *.workers.dev
# (the domain must be on the same Cloudflare account).
CUSTOM_DOMAIN=

# Optional: a dotenv file with CLOUDFLARE_API_TOKEN (otherwise `wrangler login`).
CLOUDFLARE_ENV_FILE=
